NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Configuration
# Local Compass URI: mongodb://127.0.0.1:27017/bit_mess
# Cloud Atlas Compass URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bit_mess?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bit_mess
MONGODB_DB_NAME=bit_mess

# Render persistent disks are mounted at /var/data. Locally, the default is backend/data.
# DATA_DIR=/var/data
# Optional, only needed for Google sign-in:
# GOOGLE_CLIENT_ID=
